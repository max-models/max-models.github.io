---
// A card for each project, in sidebar order: the featured projects first, on larger cards.
import { getSection, href } from '../lib/entries';

const projects = (await getSection('projects')).sort(
	(a, b) => (a.data.sidebar.order ?? Infinity) - (b.data.sidebar.order ?? Infinity)
);
const groups = [
	{ title: 'Featured', items: projects.filter((p) => p.data.featured), featured: true },
	{ title: 'More projects', items: projects.filter((p) => !p.data.featured), featured: false },
];
---

{
	groups.map((group) => (
		<>
			<h2>{group.title}</h2>
			<ul class:list={['projects', 'not-content', { featured: group.featured }]}>
				{group.items.map((p) => (
					<li>
						<a href={href(p)}>
							{p.data.image && <img src={p.data.image} alt="" loading="lazy" />}
							<span class="title">{p.data.title}</span>
							{p.data.description && <span class="description">{p.data.description}</span>}
						</a>
					</li>
				))}
			</ul>
		</>
	))
}

<style>
	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 1rem;
		list-style: none;
		padding: 0;
		margin-top: 1.5rem;
	}
	.projects.featured {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
		gap: 1.5rem;
	}
	a {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
	}
	a:hover {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
	}
	img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: contain;
		border-radius: 0.25rem;
		/* white in both themes: most pictures are plots made for a white page */
		background: white;
	}
	.title {
		font-weight: 600;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}
	/* closer to the shape of most pictures, so dark ones get thinner bars */
	.featured img {
		aspect-ratio: 4 / 3;
	}
	.featured .title {
		font-size: var(--sl-text-xl);
	}
	.description {
		font-size: var(--sl-text-sm);
	}
	.featured .description {
		font-size: var(--sl-text-base);
	}
</style>
