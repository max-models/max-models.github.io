---
// Starlight's page title, followed by the reference of a publication.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { citationHtml } from '../lib/entries';

const { data } = Astro.locals.starlightRoute.entry;
---

<Default />
{
	data.citation && (
		<div class="page-meta">
			<p set:html={citationHtml(data.citation)} />
			<p>
				{data.venue}
				{data.date && <>{' · '}{data.date.getUTCFullYear()}</>}
				{data.doi && (
					<>
						{' · '}
						<a href={`https://doi.org/${data.doi}`}>doi:{data.doi}</a>
					</>
				)}
			</p>
		</div>
	)
}

<style>
	.page-meta {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.page-meta p + p {
		margin-top: 0.25rem;
	}
	/* outside .sl-markdown-content, so Starlight's link colours don't apply */
	.page-meta a {
		color: var(--sl-color-text-accent);
	}
	.page-meta a:hover {
		color: var(--sl-color-white);
	}
</style>
