---
// Figures from the documentation of a project, each linking to the page it is on. A figure with a
// picture and Plotly JSON gets a button that replaces the picture by the interactive plot, loaded
// on click; a figure with only Plotly JSON is drawn as a static plot once it scrolls into view.
import { resolveFigures, type Figure } from '../lib/figures';

interface Props {
	figures: Figure[];
}

const figures = await resolveFigures(Astro.props.figures);
---

{
	figures.length > 0 && (
		<>
			<h2 id="from-the-documentation">From the documentation</h2>
			<ul class="gallery not-content">
				{figures.map((f) => (
					<li data-plotly={f.plotly} class:list={{ 'plotly-only': !f.src }}>
						{f.src && f.plotly && <div class="plot" />}
						<a href={f.page}>
							{f.src ? <img src={f.src} alt="" loading="lazy" /> : <div class="tile" role="img" aria-label={f.caption} />}
							<span>{f.caption}</span>
						</a>
						{f.src && f.plotly && (
							<button type="button" class="interact">
								Rotate in 3D
							</button>
						)}
					</li>
				))}
			</ul>
		</>
	)
}

<script>
	// Plotly (all trace types: heatmaps, contours, 3D), from the CDN, only once a plot is needed
	const PLOTLY = {
		src: 'https://cdn.jsdelivr.net/npm/plotly.js-dist-min@3.1.0/plotly.min.js',
		integrity: 'sha384-DAxS2fhSGacPW3IdpTjDpu+KotwjM8aHsfrkZRnfYyJIhAHoDav7jAJ+NmYcp6PL',
	};

	let plotly: Promise<any> | undefined;

	function loadPlotly(): Promise<any> {
		plotly ??= new Promise((resolve, reject) => {
			const script = Object.assign(document.createElement('script'), { ...PLOTLY, crossOrigin: 'anonymous' });
			script.onload = () => resolve((window as any).Plotly);
			script.onerror = () => {
				plotly = undefined;
				reject(new Error('Plotly did not load'));
			};
			document.head.append(script);
		});
		return plotly;
	}

	// A figure the docs draw only with Plotly: a small static plot on the white tile, without
	// legend, titles or tick labels, drawn when it comes into view.
	async function drawTile(item: HTMLElement) {
		const tile = item.querySelector<HTMLElement>('.tile')!;
		try {
			const [Plotly, figure] = await Promise.all([loadPlotly(), fetch(item.dataset.plotly!).then((r) => r.json())]);
			const layout = { xaxis: {}, yaxis: {}, ...figure.layout };
			// no tick labels or axis titles: they do not fit on a tile
			for (const key of Object.keys(layout).filter((k) => /^[xy]axis\d*$/.test(k)))
				layout[key] = { ...layout[key], showticklabels: false, title: undefined };
			await Plotly.newPlot(
				tile,
				figure.data,
				{
					...layout,
					title: undefined,
					showlegend: false,
					autosize: true,
					width: undefined,
					height: undefined,
					margin: { l: 8, r: 8, t: 8, b: 8 },
					paper_bgcolor: 'white',
					plot_bgcolor: 'white',
					font: { ...layout.font, color: '#333' },
				},
				{ staticPlot: true, responsive: true, displayModeBar: false }
			);
		} catch {
			tile.classList.add('failed');
		}
	}

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries.filter((e) => e.isIntersecting)) {
				observer.unobserve(entry.target);
				drawTile(entry.target as HTMLElement);
			}
		},
		{ rootMargin: '200px' }
	);
	for (const item of document.querySelectorAll<HTMLElement>('.gallery .plotly-only')) observer.observe(item);

	for (const button of document.querySelectorAll<HTMLButtonElement>('.gallery .interact')) {
		const item = button.closest<HTMLElement>('[data-plotly]')!;
		button.addEventListener('click', async () => {
			button.disabled = true;
			button.textContent = 'Loading…';
			try {
				const [Plotly, figure] = await Promise.all([
					loadPlotly(),
					fetch(item.dataset.plotly!).then((r) => r.json()),
				]);
				item.classList.add('active');
				await Plotly.newPlot(item.querySelector('.plot'), {
					...figure,
					layout: { ...figure.layout, autosize: true, width: undefined, height: undefined },
					config: { responsive: true, displaylogo: false },
				});
				button.remove();
			} catch {
				item.classList.remove('active');
				button.disabled = false;
				button.textContent = 'Could not load: try again';
			}
		});
	}
</script>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 1rem;
		list-style: none;
		padding: 0;
	}
	li {
		position: relative;
	}
	a {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		padding: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	a:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	img,
	.tile {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: contain;
		border-radius: 0.25rem;
		/* matplotlib output assumes a white page */
		background: white;
	}
	.tile {
		overflow: hidden;
	}
	/* the hover of the plot would take the clicks of the link */
	.tile :global(.js-plotly-plot) {
		pointer-events: none;
	}
	.interact {
		position: absolute;
		top: 1rem;
		right: 1rem;
		padding: 0.25rem 0.75rem;
		border: none;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		cursor: pointer;
	}
	.interact:hover {
		background: var(--sl-color-accent-high);
	}
	.plot {
		display: none;
	}
	/* the interactive plot takes the whole row, above its caption */
	.active {
		grid-column: 1 / -1;
	}
	.active .plot {
		display: block;
		height: min(36rem, 75vh);
		margin-bottom: 0.5rem;
		border-radius: 0.5rem;
		overflow: hidden;
		background: white;
	}
	.active img {
		display: none;
	}
	.active a {
		height: auto;
	}
</style>
